# Database: use the provider's pooled PostgreSQL connection string.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# Direct (non-pooled) PostgreSQL URL, used only by Alembic migrations.
MIGRATION_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@DIRECT_HOST:5432/DATABASE?sslmode=require
SESSION_TOKEN_PEPPER=replace-with-a-random-secret-of-at-least-32-bytes
ENV=development
CORS_ORIGINS=http://localhost:3000,https://your-new-frontend.vercel.app
TRUST_RAILWAY_PROXY=false
PORT=8000
LOG_LEVEL=INFO

# Legacy FinishAI text profile (names and model order retained).
USE_GROQ=false
OPENAI_API_KEY=
GROQ_API_KEY=

# Legacy career-agent text profile.
GEMINI_API_KEY=
# Present in the legacy config but not an active career-chain tier; kept for compatibility.
NVIDIA_API_KEY=
HF_TOKEN=
OLLAMA_BASE_URL=http://localhost:11434

# Decision-only Jev adapter; empty settings disable verification safely.
JEV_PROVIDER=
JEV_MODEL_ID=
JEV_API_KEY=
JEV_BASE_URL=

# Shared AI time budget and per-call timeout (seconds).
AI_BUDGET_PLAN_SECONDS=20
AI_BUDGET_REPLAN_SECONDS=10
AI_CALL_TIMEOUT_SECONDS=8
REACT_MAX_STEPS=4

# Limits.
REQUEST_BODY_MAX_BYTES=32768
MAX_PDF_SIZE_MB=5
RATE_LIMIT_ANY_PER_MINUTE=120
RATE_LIMIT_SESSION_PER_HOUR=10
RATE_LIMIT_SESSION_PER_DAY=40
RATE_LIMIT_LLM_IP_PER_HOUR=30
RATE_LIMIT_REPLANS_PER_GOAL_PER_DAY=10
LLM_GLOBAL_CALLS_PER_DAY=10000
LLM_GLOBAL_CALLS_PER_MONTH=200000
SESSION_TOKEN_TTL_DAYS=90
